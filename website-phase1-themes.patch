     <!-- PWA & Mobile Web Capabilities -->
 <link rel="manifest" href="{% url 'manifest' %}">
-<meta name="theme-color" content="#1e3a8a">
+<meta name="color-scheme" content="light dark">
+<meta name="theme-color" content="#0F2438">
+<script>
+  /* Runs before the page is drawn so the saved theme is in place from the first paint. */
+  (function () {
+    try {
+      var saved = localStorage.getItem('camino-theme');
+      if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
+    } catch (e) {}
+    var cache = {};
+    /* The current value of a theme colour, for scripts that draw (charts, the map line). */
+    window.caminoColor = function (name) {
+      if (!(name in cache)) cache[name] = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
+      return cache[name];
+    };
+    window.caminoColor.reset = function () { cache = {}; };
+  })();
+</script>
